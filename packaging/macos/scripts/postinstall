#!/bin/bash
# Installs the screenreader addon into the Kodi profile of every user that
# uses Kodi (and the logged-in user), like the Windows installer does for %APPDATA%\Kodi.
#
# KODI_SR_USERS_ROOT and KODI_SR_SKIP_CHOWN exist only for testing outside the installer.

SHARE_DIR="/Library/Application Support/Kodi Screenreader"
ADDON_ID="service.xbmc.tts"
USERS_ROOT="${KODI_SR_USERS_ROOT:-/Users}"

log() { echo "kodi-screenreader: $*"; }

target_users() {
    local console_user
    console_user=$(stat -f%Su /dev/console 2>/dev/null)
    if [ -n "$console_user" ] && [ "$console_user" != "root" ] && [ -d "$USERS_ROOT/$console_user" ]; then
        echo "$console_user"
    fi
    for home in "$USERS_ROOT"/*; do
        [ -d "$home/Library/Application Support/Kodi" ] && basename "$home"
    done
}

# Kodi only loads addons that are enabled in its addon database. Enabling it
# there makes the screenreader speak right on the next start, without F12.
enable_in_addon_db() {
    local db="$1"
    local columns
    columns=$(sqlite3 "$db" "PRAGMA table_info(installed);" 2>/dev/null | cut -d'|' -f2)
    if ! echo "$columns" | grep -qx "addonID"; then
        log "unknown addon database layout in $db, skipping"
        return
    fi
    local insert_cols="addonID, enabled, installDate" insert_vals="'$ADDON_ID', 1, datetime('now')"
    if echo "$columns" | grep -qx "origin"; then
        insert_cols="$insert_cols, origin"
        insert_vals="$insert_vals, ''"
    fi
    sqlite3 "$db" "INSERT OR IGNORE INTO installed ($insert_cols) VALUES ($insert_vals);" &&
    sqlite3 "$db" "UPDATE installed SET enabled = 1 WHERE addonID = '$ADDON_ID';" || return
    if echo "$columns" | grep -qx "disabledReason"; then
        sqlite3 "$db" "UPDATE installed SET disabledReason = 0 WHERE addonID = '$ADDON_ID';"
    fi
    log "enabled $ADDON_ID in $db"
}

install_for_user() {
    local user="$1"
    local kodi="$USERS_ROOT/$user/Library/Application Support/Kodi"
    local addon_data="$kodi/userdata/addon_data/$ADDON_ID"

    log "installing for $user"
    mkdir -p "$kodi/addons" "$kodi/userdata/keymaps" "$addon_data"

    rm -rf "$kodi/addons/$ADDON_ID"
    cp -R "$SHARE_DIR/$ADDON_ID" "$kodi/addons/$ADDON_ID"
    cp "$SHARE_DIR/$ADDON_ID.keyboard.xml" "$kodi/userdata/keymaps/"
    cp "$SHARE_DIR/ENABLED" "$addon_data/ENABLED"
    rm -f "$addon_data/DISABLED"

    if [ -z "$KODI_SR_SKIP_CHOWN" ]; then
        chown -R "$user":staff "$kodi"
    fi

    local db
    db=$(ls -1 "$kodi/userdata/Database"/Addons*.db 2>/dev/null | sort -V | tail -n 1)
    if [ -n "$db" ]; then
        enable_in_addon_db "$db"
        [ -z "$KODI_SR_SKIP_CHOWN" ] && chown "$user":staff "$db"
    else
        log "no addon database yet for $user (Kodi never started); enable with F12"
    fi
}

for user in $(target_users | sort -u); do
    install_for_user "$user"
done

exit 0
